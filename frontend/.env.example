# URL base del HTTP API, tal como la imprime el output ApiBaseUrl del stack.
# Si se deja sin definir, la app arranca con un mazo de demostracion local.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Mazo que se carga al abrir la app (deriva del nombre del .md subido a S3).
VITE_DEFAULT_DECK_ID=fundamentos-de-aws
