# URL base del REST API, tal como la imprime el output ApiBaseUrl del stack.
# Incluye el stage (/v1). Sin comilla ni barra final.
#
# Si se deja sin definir, la app arranca con el catálogo de demostración de
# src/data/demoData.js y no llama a AWS.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.mx-central-1.amazonaws.com/v1
