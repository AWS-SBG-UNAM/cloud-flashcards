.venv*/
venv/
env/

# ---------------------------------------------------------------------------
# AWS SAM
# ---------------------------------------------------------------------------
.aws-sam/
packaged.yaml

# samconfig.toml queda fuera porque graba el bucket de artefactos y la cuenta
# concretos del despliegue. El Makefile pasa los parametros de forma explicita,
# asi que no hace falta para reproducir el deploy.
samconfig.toml

